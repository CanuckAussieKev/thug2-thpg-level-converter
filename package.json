{
  "name": "thug2-thpg-level-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "THUG2 THPG Level Converter: Tony Hawk's Proving Ground (Xbox 360) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thpg-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "commands": [
    "thpg_levels/thpg_levels.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#265d9857e3cb880f66899a0880a11d95ec9fa569",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#d6964843cb7cbf5c34ecf36b9076d9adc22e6ff7",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#d0a290a2327e51579b8299f33f83d50a0f828fd0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
