{
  "name": "thug2-thpg-level-converter",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "THUG2 THPG Level Converter: Tony Hawk's Proving Ground (Xbox 360) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thpg-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "commands": [
    "thpg_levels/thpg_levels.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#1d172be89692cff3859b379937e842a9fdac4fd2",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#daf3efb39fc342a4a44d7b57ed728d68335bba56",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#114631bfad55e4c2994b9d7a1405ea94b50d6940"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
