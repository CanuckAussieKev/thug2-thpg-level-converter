{
  "name": "thug2-thpg-level-converter",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "description": "THUG2 THPG Level Converter: Tony Hawk's Proving Ground (Xbox 360) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thpg-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "commands": [
    "thpg_levels/thpg_levels.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#0c5e0d77a97debf79558e36d2ff118fd6c2affeb",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#7e399b2343d1556166c8106d28dc43d14397bb5c",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#1a1b150f93a8b4fea4214b0f6780d0092d4a2d2c"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
